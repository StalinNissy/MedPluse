PORT=5001
DB_URL=localhost:27017/healthcare
JWT_SECRET=change-this-to-a-long-random-secret

# ============================================================
# FREE CLOUD AI KEY (pick ONE — no local install needed)
# ============================================================
#
# Option 1 — Google Gemini (recommended)
#   1. Open https://aistudio.google.com/apikey
#   2. Sign in with Google → Create API key
#   3. Paste the key below (starts with AIza...)
#
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
#
# Option 2 — Groq (fast, free Llama models)
#   1. Open https://console.groq.com/keys
#   2. Sign up → Create API key
#   3. Paste below (starts with gsk_...)
#
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.1-8b-instant
#
# Option 3 — OpenRouter (free open-source models)
#   1. Open https://openrouter.ai/keys
#   2. Sign up → Create API key
#   3. Paste below (starts with sk-or-...)
#
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
